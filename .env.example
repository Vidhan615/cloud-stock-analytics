APP_ENV=development
DATABASE_URL=sqlite:///instance/cloudfolio.db
# Production requires a random secret of at least 32 characters.
# Generate locally: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Required only for Docker Compose. Use URL-safe generated hex strings.
DB_PASSWORD=
DB_ROOT_PASSWORD=
COOKIE_SECURE=false
# AWS instance-role credentials are used; never add access keys here.
AWS_REGION=ap-south-1
S3_BUCKET=
DB_SECRET_ARN=
DB_HOST=
DB_NAME=cloudfolio
DB_TLS_CA=
